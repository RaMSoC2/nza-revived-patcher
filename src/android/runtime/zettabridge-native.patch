@@ -42,4 +51,101 @@ bool HostPlatformCompat::handle_host_call(std::uint32_t index, GuestThread& thre
     return false;
 }
 
+bool HostPlatformCompat::bitmap_call(std::uint32_t index, GuestThread& thread) {
+#if defined(__ANDROID__)
+    if (index != ZB_COMPAT_HC_AndroidBitmap_getInfo &&
+        index != ZB_COMPAT_HC_AndroidBitmap_lockPixels &&
+        index != ZB_COMPAT_HC_AndroidBitmap_unlockPixels) return false;
+    struct Api {
+        void* library = dlopen("libjnigraphics.so", RTLD_NOW | RTLD_LOCAL);
+        decltype(&AndroidBitmap_getInfo) info = library ? reinterpret_cast<decltype(info)>(dlsym(library,"AndroidBitmap_getInfo")) : nullptr;
+        decltype(&AndroidBitmap_lockPixels) lock = library ? reinterpret_cast<decltype(lock)>(dlsym(library,"AndroidBitmap_lockPixels")) : nullptr;
+        decltype(&AndroidBitmap_unlockPixels) unlock = library ? reinterpret_cast<decltype(unlock)>(dlsym(library,"AndroidBitmap_unlockPixels")) : nullptr;
+    };
+    static Api api;
+    if (!api.info || !api.lock || !api.unlock) return false;
+    auto& regs = thread.regs();
+    const auto destination = regs[2];
+    auto* env = reinterpret_cast<JNIEnv*>(static_cast<std::uintptr_t>(jni_->current_env()));
+    auto bitmap = reinterpret_cast<jobject>(static_cast<std::uintptr_t>(jni_->resolve_ref(regs[1],"AndroidBitmap")));
+    regs[0] = static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_BAD_PARAMETER);
+    if (!env || !bitmap) return true;
+    if (env->ExceptionCheck()) {regs[0]=static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_JNI_EXCEPTION);return true;}
+    if (index == ZB_COMPAT_HC_AndroidBitmap_unlockPixels) {
+        Pixels entry{};
+        bool found=false;
+        {
+            std::lock_guard<std::mutex> guard(pixels_mutex_);
+            for (auto it=pixels_.begin();it!=pixels_.end();++it) {
+                auto real=reinterpret_cast<jobject>(static_cast<std::uintptr_t>(it->bitmap));
+                if (!env->IsSameObject(bitmap,real)) continue;
+                if (it->depth>1) {--it->depth;regs[0]=0;return true;}
+                entry=*it;pixels_.erase(it);found=true;break;
+            }
+        }
+        if (!found) return true;
+        const auto* guest=runtime_->memory().host_ptr(entry.guest,entry.size,kPageRead);
+        if (guest) std::memcpy(entry.host,guest,entry.size);
+        regs[0]=static_cast<std::uint32_t>(api.unlock(env,bitmap));
+        env->DeleteGlobalRef(reinterpret_cast<jobject>(static_cast<std::uintptr_t>(entry.bitmap)));
+        GuestCall free_call;free_call.regs={entry.guest,0,0,0};
+        runtime_->call_on_current(runtime_->service_api().free_fn,free_call);
+        if (!guest) regs[0]=static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_BAD_PARAMETER);
+        runtime_report().note_jni_detail("bitmap-bridge","real pixels copied back and unlocked",true);
+        return true;
+    }
+    AndroidBitmapInfo info{};
+    const int info_result=api.info(env,bitmap,&info);
+    regs[0]=static_cast<std::uint32_t>(info_result);
+    if (info_result != ANDROID_BITMAP_RESULT_SUCCESS) return true;
+    if (index == ZB_COMPAT_HC_AndroidBitmap_getInfo) {
+        static_assert(sizeof(AndroidBitmapInfo)==20);
+        auto* guest=runtime_->memory().host_ptr(destination,sizeof(info),kPageWrite);
+        if (guest) std::memcpy(guest,&info,sizeof(info));
+        else regs[0]=static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_BAD_PARAMETER);
+        return true;
+    }
+    auto* pointer=runtime_->memory().host_ptr(destination,4,kPageWrite);
+    regs[0]=static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_BAD_PARAMETER);
+    const std::uint64_t size=static_cast<std::uint64_t>(info.stride)*info.height;
+    if (!pointer || !size || size>128*1024*1024) return true;
+    {
+        std::lock_guard<std::mutex> guard(pixels_mutex_);
+        for (auto& entry:pixels_) {
+            if (env->IsSameObject(bitmap,reinterpret_cast<jobject>(static_cast<std::uintptr_t>(entry.bitmap)))) {
+                ++entry.depth;std::memcpy(pointer,&entry.guest,4);regs[0]=0;return true;
+            }
+        }
+    }
+    void* pixels=nullptr;
+    const int locked=api.lock(env,bitmap,&pixels);
+    regs[0]=static_cast<std::uint32_t>(locked);
+    if (locked != ANDROID_BITMAP_RESULT_SUCCESS) return true;
+    GuestCall allocate;allocate.regs={static_cast<std::uint32_t>(size),0,0,0};
+    const auto allocation=runtime_->call_on_current(runtime_->service_api().malloc_fn,allocate);
+    auto* guest=allocation && allocation->r0 ? runtime_->memory().host_ptr(allocation->r0,size,kPageWrite) : nullptr;
+    jobject global=guest ? env->NewGlobalRef(bitmap) : nullptr;
+    if (!guest || !global || !pixels) {
+        api.unlock(env,bitmap);
+        if (global) env->DeleteGlobalRef(global);
+        if (allocation && allocation->r0) {
+            GuestCall release;release.regs={allocation->r0,0,0,0};
+            runtime_->call_on_current(runtime_->service_api().free_fn,release);
+        }
+        regs[0]=static_cast<std::uint32_t>(ANDROID_BITMAP_RESULT_ALLOCATION_FAILED);return true;
+    }
+    std::memcpy(guest,pixels,size);
+    {
+        std::lock_guard<std::mutex> guard(pixels_mutex_);
+        pixels_.push_back({reinterpret_cast<std::uintptr_t>(global),pixels,allocation->r0,size});
+    }
+    std::memcpy(pointer,&allocation->r0,4);regs[0]=0;
+    runtime_report().note_jni_detail("bitmap-bridge","real pixels copied to guest, bytes="+std::to_string(size),true);
+    return true;
+#else
+    (void)index;(void)thread;
+    return false;
+#endif
+}
+
 }  // namespace zb
