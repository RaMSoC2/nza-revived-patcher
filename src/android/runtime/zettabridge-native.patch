+bool Process::legacy_ashmem_ioctl(int fd, std::uint32_t request, std::uint32_t arg, std::int32_t& result) {
+    struct stat st;
+    if (::fstat(fd, &st) != 0) return false;
+    std::lock_guard<std::mutex> lock(ashmem_mutex_);
+    const auto it = legacy_ashmem_.find({st.st_dev, st.st_ino});
+    if (it == legacy_ashmem_.end()) return false;
+    auto& region = it->second;
+    result = 0;
+    switch (request) {
+    case ASHMEM_SET_NAME: {
+        const auto* p = mem_.host_ptr(arg, ASHMEM_NAME_LEN, kPageRead);
+        if (!p) { result = -EFAULT; break; }
+        region.name.assign(reinterpret_cast<const char*>(p),
+                           strnlen(reinterpret_cast<const char*>(p), ASHMEM_NAME_LEN-1));
+        break;
+    }
+    case ASHMEM_GET_NAME: {
+        auto* p = mem_.host_ptr(arg, ASHMEM_NAME_LEN, kPageWrite);
+        if (!p) { result = -EFAULT; break; }
+        std::memset(p, 0, ASHMEM_NAME_LEN);
+        std::memcpy(p, region.name.data(), region.name.size());
+        break;
+    }
+    case 0x40047703: // ARM32 ASHMEM_SET_SIZE: scalar, not a guest pointer.
+        if (::ftruncate(fd, static_cast<off_t>(arg)) != 0) result = -errno;
+        break;
+    case ASHMEM_GET_SIZE: result = static_cast<std::int32_t>(st.st_size); break;
+    case 0x40047705: // Restrictions affect subsequent guest mappings.
+        if ((arg & ~region.prot) != 0) result = -EINVAL;
+        else region.prot = arg;
+        break;
+    case ASHMEM_GET_PROT_MASK: result = static_cast<std::int32_t>(region.prot); break;
+    default: result = -EOPNOTSUPP; break; // Pin/purge behavior has not been implemented.
+    }
+    return true;
+}
