+std::int32_t Process::open_legacy_ashmem(int flags) {
+    const int fd = static_cast<int>(::syscall(SYS_memfd_create, "nza-legacy-ashmem",
+                                            (flags & O_CLOEXEC) ? kMfdCloexec : 0u));
+    if (fd < 0) return -errno;
+    struct stat st;
+    if (::fstat(fd, &st) != 0) { const int error = errno; ::close(fd); return -error; }
+    std::lock_guard<std::mutex> lock(ashmem_mutex_);
+    legacy_ashmem_[{st.st_dev, st.st_ino}] = {};
+    return fd;
+}
+
+bool Process::legacy_ashmem_allows(int fd, int prot) {
